# Graficas de las personas entre 18 y 60 años (datos/data.csv, sacado de data.xlsx)
NERV "Graficas edad 18 a 60"

personas = ENTRY_PLUG "datos/data.csv"
    |> AT_FIELD donde edad >= 18 y edad <= 60
    |> SYNC nivel_edu = reemplazar(nivel_edu, "Prrimaria", "Primaria")

MONITOR personas |> MAGI n = contar(), promedio_edad = media(edad), promedio_ingreso = media(ingreso_mensual)

# 1) Cuantas personas hay de cada edad
HOLOGRAM histograma de personas {
    eje_x: edad
    intervalos: 21
    titulo: "Edades entre 18 y 60"
    etiqueta_x: "Edad"
    etiqueta_y: "Personas"
    archivo: "salidas/edad_histograma.png"
}

# 2) Cada punto es una persona: edad contra ingreso, por sexo
HOLOGRAM dispersion de personas {
    eje_x: edad
    eje_y: ingreso_mensual
    serie: sex
    titulo: "Edad contra ingreso mensual"
    etiqueta_x: "Edad"
    etiqueta_y: "Ingreso mensual"
    archivo: "salidas/edad_dispersion.png"
}

# 3) Ingreso promedio segun el nivel educativo
por_nivel = personas
    |> SQUAD por [nivel_edu]
    |> MAGI promedio = media(ingreso_mensual)
    |> FORMATION por [promedio asc]
    |> SYNC nivel_edu = reemplazar(nivel_edu, "Medio superior y superior", "Media y superior")
    |> SYNC nivel_edu = reemplazar(nivel_edu, "incompleta", "incomp.")
    |> SYNC nivel_edu = reemplazar(nivel_edu, "Secundaria completa", "Secundaria comp.")
HOLOGRAM barras de por_nivel {
    eje_x: nivel_edu
    eje_y: promedio
    titulo: "Ingreso promedio por nivel educativo"
    etiqueta_x: "Nivel educativo"
    etiqueta_y: "Ingreso promedio"
    leyenda: falso
    ancho: 1100
    archivo: "salidas/edad_barras.png"
}

# 4) Como se reparte la edad en hombres y mujeres
HOLOGRAM caja de personas {
    eje_x: sex
    eje_y: edad
    titulo: "Edad por sexo"
    etiqueta_x: "Sexo"
    etiqueta_y: "Edad"
    leyenda: falso
    archivo: "salidas/edad_caja.png"
}
